<IfModule mod_expires.c>
    # Turn on the module
    ExpiresActive On

    # 1. Default caching (for anything not specified below) - 1 hour
    ExpiresDefault "access plus 1 hour"

    # 2. HTML Files: Do not cache them (or force revalidation)
    # This ensures users always see your latest content updates
    ExpiresByType text/html "access plus 0 seconds"

    # 3. Media files: Cache for 1 year
    # Images, video, audio
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"

    # 4. CSS and JavaScript: Cache for 1 year
    # (Highly recommended to use Hugo's fingerprinting for these!)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"

    # 5. Web Fonts: Cache for 1 year
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Ensure HTML files are never served from the browser cache without checking the server first
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
    
    # Optional: Add Immutable flag for assets if you use Hugo fingerprinting
    <FilesMatch "\.(css|js|png|jpe?g|webp|woff2?|mp4|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
